    {
      "name": "deploy-arch-ibm-ocp-vpc",
      "label": "Red Hat OpenShift Container Platform on VPC",
      "product_kind": "solution",
      "provider_name": "IBM",
      "tags": [
        "compute"
      ],
      "keywords": [
        "openshift",
        "ocp",
        "vpc",
        "kubernetes",

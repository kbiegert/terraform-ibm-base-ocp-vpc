        "terraform"
      ],
      "short_description": "Deploy Red Hat OpenShift Container Platform on IBM Cloud VPC infrastructure",
      "long_description": "This deployable architecture provides a comprehensive solution for deploying production-ready Red Hat OpenShift Container Platform clusters on IBM Cloud Virtual Private Cloud (VPC). It supports multiple deployment variations from simple QuickStart configurations for development to fully configurable production deployments with integrated security, observability, and compliance features.",
      "offering_docs_url": "https://github.com/terraform-ibm-modules/terraform-ibm-base-ocp-vpc",
      "offering_icon_url": "https://raw.githubusercontent.com/terraform-ibm-modules/terraform-ibm-base-ocp-vpc/main/images/ocp_icon.svg",
      "features": [
        {
          "title": "Multi-Zone High Availability",
          "description": "Deploys OpenShift clusters across multiple availability zones for enhanced resilience and fault tolerance"
        },
        {
          "title": "Integrated Security",
          "description": "Optional [Key Protect](https://cloud.ibm.com/docs/key-protect) encryption for cluster and boot volumes, [Secrets Manager](https://cloud.ibm.com/docs/secrets-manager) integration for certificate management"
        },
        {
          "title": "Comprehensive Observability",
          "description": "Optional integration with [Cloud Logs](https://cloud.ibm.com/docs/cloud-logs), [Monitoring](https://cloud.ibm.com/docs/monitoring), and [Activity Tracker](https://cloud.ibm.com/docs/activity-tracker) for complete visibility"
        },
        {
          "title": "Advanced Security Groups",
          "description": "Flexible security group management for worker nodes, VPEs, and load balancers with custom rules support"
        },
        {
          "title": "Flexible Worker Pools",
          "description": "Support for multiple worker pools with auto-scaling, custom machine types, and per-pool security configurations"
        },
        {
          "title": "Compliance Ready",
          "description": "Built-in support for [Security and Compliance Center](https://cloud.ibm.com/docs/security-compliance) and [Workload Protection](https://cloud.ibm.com/docs/workload-protection)"
        }
      ],
